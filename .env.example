NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used to send lead emails from the admin-configured templates (https://resend.com/api-keys)
RESEND_API_KEY=
# Verified sender address; defaults to onboarding@resend.dev (Resend's unverified-domain test sender)
RESEND_FROM_EMAIL=

# Shared secret the /api/cron/cadences route requires as a Bearer token.
# Vercel Cron sends this automatically once set as a project env var.
CRON_SECRET=
